{
  "name": "todolist-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Todo List multi-tenant POC — NestJS + Fastify + Kysely + AWS Lambda + Cognito + PostgreSQL",
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint \"{packages,modules}/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:cov": "jest --coverage",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:migrate": "ts-node scripts/run-migrations.ts",
    "db:codegen": "kysely-codegen --out-file packages/shared/src/infrastructure/database/schema.types.ts",
    "cognito:bootstrap": "ts-node scripts/bootstrap-cognito.ts",
    "dev:tenants": "npm --workspace @todolist/tenants run dev",
    "dev:users": "npm --workspace @todolist/users run dev",
    "dev:activities": "npm --workspace @todolist/activities run dev",
    "demo": "ts-node scripts/e2e-demo.ts",
    "create:module": "ts-node scripts/create-module.ts",
    "remove:module": "ts-node scripts/remove-module.ts",
    "dev:all": "concurrently -n activities,tenants,users -c auto \"AUTH_MODE=local npm run dev:activities\" \"AUTH_MODE=local npm run dev:tenants\" \"AUTH_MODE=local npm run dev:users\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.15.0",
    "pg": "^8.11.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
